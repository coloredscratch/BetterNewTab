{
  "manifest_version": 3,
  "version": "1.0.2",
  "name": "Right Click Me and Click Remove!",
  "description": "Standalone extension for the custom Dark 2.0 New Tab page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}